// API Worker の設定。シークレットの値はここに書かない（wrangler secret put で登録する）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maaun-stock-insight",
  "main": "crates/api-worker/build/index.js",
  "compatibility_date": "2026-10-01",
  "build": {
    // API Worker（wasm）だけをビルドする。画面（web/dist）は先に `pnpm --dir web build` で作っておく
    "command": "cd crates/api-worker && worker-build --release"
  },
  // 画面は静的アセットとして配信し、/api/* だけ Worker を通す
  "assets": {
    "directory": "web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 本番のドメイン。デプロイ時に DNS レコードと証明書が作られる
  "routes": [{ "pattern": "stock.insight.maa-un.com", "custom_domain": true }],
  // 公開の入口はカスタムドメインだけにする。プレビュー URL（versions upload）は残す
  "workers_dev": false,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maaun-stock-insight",
      // 秘密ではない（wrangler d1 info maaun-stock-insight で確認できる）
      "database_id": "9ffd69bf-18dd-4bc0-8fb4-eb4ff1da13fb",
      "migrations_dir": "migrations"
    }
  ],
  // 秘密ではない設定。CLERK_SECRET_KEY と ADMIN_NOTIFY_EMAIL は wrangler secret put で登録する
  "vars": {
    // PropFolio と共通の Clerk 本番インスタンス（Frontend API）
    "CLERK_ISSUER": "https://clerk.maa-un.com",
    "CLERK_API_URL": "https://api.clerk.com/v1",
    // トークンの発行先（azp）として受け付けるオリジン
    "AUTHORIZED_PARTIES": "https://stock.insight.maa-un.com"
  },
  // AIレコメンド（F7）に使う Workers AI。設定だけで有効になる（ダッシュボードの操作は不要）
  "ai": { "binding": "AI" },
  // 日次バッチ（18:30 JST）とAIレコメンド（19:30 JST）は GitHub Actions の schedule に移した。既存の Worker Cron は deploy 時にこの空配列で削除する（triggers 自体を消すと既存スケジュールが残る）
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
}
